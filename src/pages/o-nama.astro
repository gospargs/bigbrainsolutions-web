---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const nav = [
  { href: '/usluge/', label: 'Usluge' },
  { href: '/o-nama/', label: 'O nama' },
  { href: '/homestock/', label: 'HomeStock' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<BaseLayout
	lang="hr"
	title="O nama — Big Brain Solutions"
	description="Upoznajte Gordana Sentića, osnivača Big Brain Solutionsa — IT i web tvrtke iz Dubrovnika s više od 6 godina iskustva u razvoju softvera i IT podršci."
>
	<Header lang="hr" nav={nav} altLangHref="/en/about/" altLangLabel="English" />

	<main class="bb-about">
		<h1>Profesionalna tvrtka za IT i web usluge</h1>
		<p class="bb-lead">
			Big Brain Solutions vodi Gordan Sentić — jedna osoba, jedan kontakt, bez prebacivanja od odjela do
			odjela. Bavimo se popravkom računala, IT podrškom, umrežavanjem te izradom web stranica i aplikacija za
			kućanstva i male tvrtke u Dubrovniku i okolici.
		</p>

		<div class="bb-founder">
			<h3>Gordan Sentić, osnivač i vodeći razvojni inženjer</h3>
			<p>
				Diplomirao sam informacijsku tehnologiju i dodatno se specijalizirao za razvoj softvera i
				administraciju mreža. Već više od šest godina radim kao softverski specijalist u Hrvatskoj banci za
				obnovu i razvoj (HBOR), a Big Brain Solutions sam pokrenuo kako bih to isto iskustvo — rad na
				ozbiljnim, produkcijskim sustavima — ponudio i lokalnim kućanstvima i malim tvrtkama kojima ta razina
				stručnosti inače nije lako dostupna.
			</p>
		</div>

		<h2>Zašto 60 dana jamstva</h2>
		<p>
			Svaki posao dolazi sa 60 dana jamstva — ne kao marketinška fraza, nego zato što stojim iza svakog
			popravka i svake linije koda koju isporučim. Cilj je da tehnologija za vas radi neprimjetno, a ako nešto
			zaškripi, vraćam se i rješavam bez dodatnih pitanja.
		</p>

		<div class="bb-about-cta">
			<h2>Imate problema s računalom?</h2>
			<p class="text-muted">
				Zakažite posjet kod vas ili u vašem poslovnom prostoru i pomoći ćemo vam sa svim potrebama vezanim za
				računala.
			</p>
			<Button href="/kontakt/" variant="primary">Zatražite ponudu</Button>
		</div>
	</main>

	<Footer
		lang="hr"
		nav={nav}
		privacyHref="/privatnost-homestock/"
		privacyLabel="Privatnost (HomeStock)"
		labels={{
			address: 'Adresa',
			contact: 'Kontakt',
			hours: 'Radno vrijeme',
			hoursValue: 'Pon–Sub 6:00–18:00',
			rights: 'Sva prava pridržana.',
			legalLine: 'BIG BRAIN SOLUTIONS, obrt za računalno programiranje, vl. Gordan Sentić · OIB: 71865731622',
		}}
	/>
</BaseLayout>

<style>
	.bb-about {
		max-width: 42rem;
		margin-inline: auto;
		padding: var(--spacing-section-mobile) 1.5rem;
	}

	.bb-lead {
		font-size: 1.125rem;
		color: var(--color-muted);
		font-family: var(--font-body);
		margin-top: 1.25rem;
	}

	.bb-about p {
		font-family: var(--font-body);
		line-height: 1.75;
		margin-top: 1rem;
	}

	.bb-about h2 {
		margin-top: 2.5rem;
	}

	.bb-founder {
		margin-top: 2.5rem;
		padding: 1.75rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background-color: var(--color-surface);
	}

	.bb-about-cta {
		margin-top: 3rem;
		padding: 2.5rem;
		border-radius: var(--radius-panel);
		border: 1px solid var(--color-border);
		background-color: var(--color-surface);
		text-align: center;
	}

	.bb-about-cta p {
		margin-bottom: 1.5rem;
	}
</style>

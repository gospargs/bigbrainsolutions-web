---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const { variant = 'primary', href, type = 'button', disabled = false, class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['bb-button', `bb-button--${variant}`, className]}
  href={href}
  type={href ? undefined : type}
  disabled={!href && disabled}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  <slot />
</Tag>

<style>
  .bb-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out, border-color 150ms ease-out;
  }

  .bb-button:disabled,
  .bb-button[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }

  .bb-button:hover {
    transform: scale(1.03);
  }

  .bb-button:active {
    transform: scale(0.98);
  }

  .bb-button--primary {
    background-color: var(--color-primary);
    color: white;
    border: 1px solid transparent;
  }

  .bb-button--primary:hover {
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  .bb-button--secondary {
    background-color: var(--color-surface);
    color: var(--color-foreground);
    border: 1px solid var(--color-border);
  }

  .bb-button--secondary:hover {
    border-color: var(--color-primary);
  }

  .bb-button--ghost {
    background-color: transparent;
    color: var(--color-foreground);
    border: 1px solid transparent;
  }

  .bb-button--ghost:hover {
    background-color: var(--color-surface);
  }
</style>

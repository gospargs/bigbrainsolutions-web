---
import { Image } from 'astro:assets';
import logoFull from '../assets/logo-full.png';
import logoIcon from '../assets/logo-icon.png';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  lang: 'hr' | 'en';
  nav: NavItem[];
  altLangHref: string;
  altLangLabel: string;
}

const { lang, nav, altLangHref, altLangLabel } = Astro.props;
const homeHref = lang === 'hr' ? '/' : '/en/';
---

<header class="bb-header">
  <div class="bb-header__inner">
    <a href={homeHref} class="bb-header__logo" aria-label="Big Brain Solutions">
      <Image src={logoFull} alt="Big Brain Solutions" class="bb-header__logo-full" height={36} widths={[248, 496]} sizes="248px" />
      <Image src={logoIcon} alt="Big Brain Solutions" class="bb-header__logo-icon" width={36} height={36} />
    </a>

    <nav class="bb-header__nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="bb-header__actions">
      <a href={altLangHref} class="bb-header__lang" aria-label={`Switch to ${altLangLabel}`}>
        {lang === 'hr' ? 'HR / EN' : 'EN / HR'}
      </a>
      <button
        class="bb-header__menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="bb-mobile-menu"
        id="bb-menu-toggle"
      >
        <span class="sr-only">Menu</span>
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <div id="bb-mobile-menu" class="bb-mobile-menu" hidden>
    <ul>
      {nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li><a href={altLangHref}>{lang === 'hr' ? 'English' : 'Hrvatski'}</a></li>
    </ul>
  </div>
</header>

<style>
  .bb-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .bb-header__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
  }

  .bb-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .bb-header__logo-full {
    display: none;
    width: auto;
  }

  .bb-header__logo-icon {
    display: block;
  }

  .bb-header__nav {
    display: none;
  }

  .bb-header__nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bb-header__nav a {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .bb-header__nav a:hover {
    color: var(--color-primary-text);
  }

  .bb-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bb-header__lang {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.375rem 0.875rem;
    transition: border-color 150ms ease-out, color 150ms ease-out;
  }

  .bb-header__lang:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-text);
  }

  .bb-header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.25rem;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .bb-mobile-menu {
    border-top: 1px solid var(--color-border);
    padding: 1rem 1.5rem 1.5rem;
  }

  .bb-mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bb-mobile-menu a {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    display: block;
    padding: 0.5rem 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (min-width: 64rem) {
    .bb-header__nav {
      display: block;
    }

    .bb-header__menu-toggle {
      display: none;
    }

    .bb-header__logo-full {
      display: block;
    }

    .bb-header__logo-icon {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('bb-menu-toggle');
  const menu = document.getElementById('bb-mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (menu) menu.hidden = isOpen;
  });
</script>

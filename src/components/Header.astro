---
import { Image, getImage } from 'astro:assets';
import logoFull from '../assets/logo-full.png';
import logoIcon from '../assets/logo-icon.png';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  lang: 'hr' | 'en';
  nav: NavItem[];
  altLangHref: string;
  altLangLabel: string;
}

const { lang, nav, altLangHref, altLangLabel } = Astro.props;
const homeHref = lang === 'hr' ? '/' : '/en/';

// Optimized URLs for the two logo assets, used as CSS mask-image sources (BUGFIX-007):
// there's no dark-colored export of the logo, and the source art is a flattened raster,
// not an editable vector, so a dark-on-light variant is derived on demand via CSS mask
// rather than sourced as a second file.
const logoFullOptimized = await getImage({ src: logoFull });
const logoIconOptimized = await getImage({ src: logoIcon });
const logoFullMaskUrl = `url(${logoFullOptimized.src})`;
const logoIconMaskUrl = `url(${logoIconOptimized.src})`;
---

<header class="bb-header">
  <div class="bb-header__inner">
    <a href={homeHref} class="bb-header__logo" aria-label="Big Brain Solutions">
      <span class="bb-logo-slot bb-logo-slot--full">
        <Image src={logoFull} alt="Big Brain Solutions" class="bb-logo-render" />
        <span class="bb-logo-render bb-logo-render--mask bb-logo-render--mask-full" aria-hidden="true"></span>
      </span>
      <span class="bb-logo-slot bb-logo-slot--icon">
        <Image src={logoIcon} alt="Big Brain Solutions" class="bb-logo-render" />
        <span class="bb-logo-render bb-logo-render--mask bb-logo-render--mask-icon" aria-hidden="true"></span>
      </span>
    </a>

    <nav class="bb-header__nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="bb-header__actions">
      <a href={altLangHref} class="bb-header__lang" aria-label={`Switch to ${altLangLabel}`}>
        {lang === 'hr' ? 'HR / EN' : 'EN / HR'}
      </a>
      <button
        class="bb-header__menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="bb-mobile-menu"
        id="bb-menu-toggle"
      >
        <span class="sr-only">Menu</span>
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <div id="bb-mobile-menu" class="bb-mobile-menu" hidden>
    <ul>
      {nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li><a href={altLangHref}>{lang === 'hr' ? 'English' : 'Hrvatski'}</a></li>
    </ul>
  </div>
</header>

<style define:vars={{ logoFullMaskUrl, logoIconMaskUrl }}>
  /*
    Header height token: 72px (--header-height below), independent of whatever logo asset
    is inside it -- see docs/decisions.md BUGFIX-005. Logo is always rendered at a fixed
    32px height with width:auto/object-fit:contain, never a forced square.
  */
  .bb-header {
    --header-height: 4.5rem;
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .bb-header__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    padding: 0 1.5rem;
  }

  .bb-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .bb-logo-slot {
    display: none;
    align-items: center;
    position: relative;
  }

  /*
    BRAND-002: the full icon+wordmark lockup is the default everywhere, including mobile --
    an abstract brain icon alone doesn't yet read as "you're on our site" for a first-time
    visitor on a brand this new. Icon-only stays available (see .bb-logo-slot--icon rule
    below) for a future scrolled/compact header state, but nothing currently triggers it.
  */
  .bb-logo-slot--full {
    display: flex;
  }

  .bb-logo-slot--icon {
    display: none;
  }

  /*
    BUGFIX-008: pushed from 32px to 52px -- as tall as the 72px header comfortably allows
    (72px - 52px = 20px of vertical breathing room, ~10px top/bottom) without growing the
    header itself. Only size/spacing can move here: the icon is a flattened raster from
    Canva, not an editable vector, so stroke weight can't be made "bolder" via CSS -- a
    heavier-stroke mark would need a new Canva export, not a CSS change.
  */
  .bb-logo-slot--full .bb-logo-render {
    height: 52px;
    width: auto;
    object-fit: contain;
  }

  .bb-logo-slot--icon .bb-logo-render {
    height: 52px;
    width: 52px;
    object-fit: contain;
  }

  /* Colorful original PNG -- correct, best-looking rendering. Default (dark theme). */
  img.bb-logo-render {
    display: block;
  }

  /* CSS-mask dark recolor for light-theme contexts (BUGFIX-007) -- hidden by default. */
  .bb-logo-render--mask {
    display: none;
    background-color: var(--color-foreground);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: left center;
    mask-position: left center;
  }

  .bb-logo-render--mask-full {
    -webkit-mask-image: var(--logoFullMaskUrl);
    mask-image: var(--logoFullMaskUrl);
    /* an empty <span> has no intrinsic size for width:auto to derive from (unlike <img>,
       which sizes from the image's natural dimensions) -- aspect-ratio fixes that so the
       masked version matches the colorful <img> version's proportions exactly. */
    aspect-ratio: 1413 / 622;
    width: auto;
  }

  .bb-logo-render--mask-icon {
    -webkit-mask-image: var(--logoIconMaskUrl);
    mask-image: var(--logoIconMaskUrl);
  }

  /* Light theme: swap the colorful <img> for the flat dark-masked version in both slots. */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) img.bb-logo-render {
      display: none;
    }
    :root:not([data-theme="dark"]) .bb-logo-render--mask {
      display: block;
    }
  }

  :root[data-theme="light"] img.bb-logo-render {
    display: none;
  }

  :root[data-theme="light"] .bb-logo-render--mask {
    display: block;
  }

  .bb-header__nav {
    display: none;
  }

  .bb-header__nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bb-header__nav a {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .bb-header__nav a:hover {
    color: var(--color-primary-text);
  }

  .bb-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bb-header__lang {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.375rem 0.875rem;
    transition: border-color 150ms ease-out, color 150ms ease-out;
  }

  .bb-header__lang:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-text);
  }

  .bb-header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.25rem;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .bb-mobile-menu {
    border-top: 1px solid var(--color-border);
    padding: 1rem 1.5rem 1.5rem;
  }

  .bb-mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bb-mobile-menu a {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    display: block;
    padding: 0.5rem 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (min-width: 64rem) {
    .bb-header__nav {
      display: block;
    }

    .bb-header__menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('bb-menu-toggle');
  const menu = document.getElementById('bb-mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (menu) menu.hidden = isOpen;
  });
</script>

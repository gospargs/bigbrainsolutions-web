---
import Button from './Button.astro';

interface Props {
  services: { value: string; label: string }[];
  turnstileSiteKey: string;
  labels: {
    name: string;
    email: string;
    clientType: string;
    clientTypeIndividual: string;
    clientTypeBusiness: string;
    service: string;
    message: string;
    submit: string;
    submitting: string;
    success: string;
    error: string;
  };
  selectedService?: string;
}

const { services, labels, selectedService, turnstileSiteKey } = Astro.props;
---

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<form id="contact-form" class="space-y-5" novalidate data-selected-service={selectedService}>
  <div>
    <label for="cf-name" class="mb-1 block text-sm font-medium">{labels.name}</label>
    <input
      id="cf-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      class="w-full rounded-card border border-border bg-background px-4 py-2.5 outline-none focus-visible:border-primary"
      aria-describedby="cf-name-error"
    />
    <p id="cf-name-error" class="mt-1 text-caption text-error-fg" role="alert" hidden></p>
  </div>

  <div>
    <label for="cf-email" class="mb-1 block text-sm font-medium">{labels.email}</label>
    <input
      id="cf-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      class="w-full rounded-card border border-border bg-background px-4 py-2.5 outline-none focus-visible:border-primary"
      aria-describedby="cf-email-error"
    />
    <p id="cf-email-error" class="mt-1 text-caption text-error-fg" role="alert" hidden></p>
  </div>

  <fieldset>
    <legend class="mb-1 block text-sm font-medium">{labels.clientType}</legend>
    <div class="flex gap-4">
      <label class="flex items-center gap-2">
        <input type="radio" name="clientType" value="individual" checked />
        {labels.clientTypeIndividual}
      </label>
      <label class="flex items-center gap-2">
        <input type="radio" name="clientType" value="business" />
        {labels.clientTypeBusiness}
      </label>
    </div>
  </fieldset>

  <div>
    <label for="cf-service" class="mb-1 block text-sm font-medium">{labels.service}</label>
    <select
      id="cf-service"
      name="service"
      required
      class="w-full min-w-0 rounded-card border border-border bg-background px-4 py-2.5 outline-none focus-visible:border-primary"
    >
      {services.map((s) => (
        <option value={s.value} selected={s.value === selectedService}>{s.label}</option>
      ))}
    </select>
  </div>

  <div>
    <label for="cf-message" class="mb-1 block text-sm font-medium">{labels.message}</label>
    <textarea
      id="cf-message"
      name="message"
      required
      rows="5"
      class="w-full rounded-card border border-border bg-background px-4 py-2.5 outline-none focus-visible:border-primary"
      aria-describedby="cf-message-error"
    ></textarea>
    <p id="cf-message-error" class="mt-1 text-caption text-error-fg" role="alert" hidden></p>
  </div>

  {/* BUGFIX-010(3): Turnstile's default "normal" size has a fixed ~300px minimum render
      width -- wider than the available space at narrow mobile widths (206px at a 320px
      viewport), causing horizontal overflow. "compact" (~150px) fits everywhere. */}
  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="compact" data-appearance="interaction-only"></div>

  {/* SECURITY-001: honeypot. display:none keeps it away from real users, screen readers and
      browser autofill; bots posting every field they find in the HTML still fill it. */}
  <div class="cf-hp">
    <label for="cf-company-website">Company website</label>
    <input id="cf-company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <Button type="submit" id="cf-submit" variant="primary">{labels.submit}</Button>

  <p id="cf-status" class="text-caption" role="status" aria-live="polite"></p>
</form>

<script is:inline define:vars={{ labels }}>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('cf-submit');
  const status = document.getElementById('cf-status');

  // Deep-link support: /kontakt/?service=web-app pre-selects the matching option
  // so Services page cards can link straight into a pre-filled form.
  const requestedService = new URLSearchParams(window.location.search).get('service');
  if (requestedService) {
    const select = document.getElementById('cf-service');
    if (select && [...select.options].some((o) => o.value === requestedService)) {
      select.value = requestedService;
    }
  }

  function setFieldError(id, message) {
    const el = document.getElementById(`${id}-error`);
    if (!el) return;
    if (message) {
      el.textContent = message;
      el.hidden = false;
    } else {
      el.hidden = true;
    }
  }

  // Same check as functions/api/contact.ts, so the form can't pass an address the server rejects.
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const fields = [
    { id: 'cf-name', isValid: (v) => !!v, error: 'Please enter your name.' },
    { id: 'cf-email', isValid: (v) => emailPattern.test(v), error: 'Please enter a valid email address.' },
    { id: 'cf-message', isValid: (v) => !!v, error: 'Please enter a message.' },
  ];
  const emailField = fields[1];
  // Fields show errors only once left or submitted, so nobody is told off mid-word on first entry.
  const touched = new Set();
  let submitting = false;

  function fieldIsValid(field) {
    return field.isValid(document.getElementById(field.id).value.trim());
  }

  // Recomputed from current values every time, so correcting a field always clears its state.
  function render() {
    fields.forEach((field) => {
      setFieldError(field.id, touched.has(field.id) && !fieldIsValid(field) ? field.error : '');
    });
    submitBtn.disabled = submitting || (touched.has(emailField.id) && !fieldIsValid(emailField));
  }

  fields.forEach((field) => {
    const input = document.getElementById(field.id);
    input.addEventListener('input', render);
    input.addEventListener('change', render);
    input.addEventListener('blur', () => {
      touched.add(field.id);
      render();
    });
  });

  function setSubmitting(value) {
    submitting = value;
    render();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    fields.forEach((field) => touched.add(field.id));
    render();
    if (!fields.every(fieldIsValid)) return;

    setSubmitting(true);
    submitBtn.textContent = labels.submitting;
    status.textContent = '';
    status.className = 'text-caption';

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      // Time since page load, not a timestamp, so a wrong device clock can't block a real visitor.
      payload.elapsedMs = Math.round(performance.now());

      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        status.textContent = labels.success;
        status.classList.add('text-success-fg');
        form.reset();
        touched.clear();
      } else {
        status.textContent = data.error || labels.error;
        status.classList.add('text-error-fg');
      }
    } catch {
      status.textContent = labels.error;
      status.classList.add('text-error-fg');
    } finally {
      // Turnstile tokens are single-use, so a retry after any outcome needs a fresh one.
      if (window.turnstile) window.turnstile.reset();
      setSubmitting(false);
      submitBtn.textContent = labels.submit;
    }
  });
</script>

<style>
  .cf-hp {
    display: none;
  }
</style>

---
// A restrained nod to falling 0s/1s -- the idea of it, not a literal Matrix screensaver.
// Sparse slow digits, canvas capped ~15fps. Mounted once at the layout level (BaseLayout) and
// runs down the full length of every page, densest at the top (MOTION-006).
// Disabled under prefers-reduced-motion (always) -- mobile is enabled as of BUGFIX-010.
//
// Tuning history (density/speed unchanged throughout -- only visibility/placement moved):
// BUGFIX-004/006: opacity 6%->12%->22% (dark theme, accent mint) -- imperceptible at lower
//   values on a real screen despite drawing correctly.
// BUGFIX-009: moved from homepage-hero-only to a shared layout-level top band on every page,
//   added theme-aware color (dark: accent mint 22%, light: muted-text 16%).
// POLISH-001: light-theme color/opacity darkened further -- muted-text wasn't dark enough
//   even at 16%. Switched to --color-foreground (the actual body-text color) at 20%.
// BUGFIX-010(1): mobile was deliberately disabled at launch (battery/perf reasoning) --
//   owner has now seen the live site on a real phone and wants it there too. Re-enabled;
//   see docs/decisions.md for the mobile performance check performed before shipping this.
// POLISH-002 (mobile-height): mobile now sizes to the full visible viewport height on load
//   (100dvh) instead of the fixed desktop band, per explicit follow-up request -- verified via
//   Lighthouse, see docs/decisions.md for before/after numbers.
// POLISH-002 (contrast, later follow-up reusing the same task ID): opacity-only tuning had
//   diminishing returns -- even at 22%/20% the digits still barely separated in luminance from
//   the near-black/near-white background on a real phone. Raised dark to 32%; light needed two
//   passes (28% was still too faint against #FAFAF9 on an actual screenshot) before landing at
//   36%. Colors (accent mint / --color-foreground) were already correct from BUGFIX-006/POLISH-001,
//   this was purely an opacity increase. See docs/decisions.md for the before/after screenshots.
// MOTION-006: replaced the top band with a page-length gradient. The canvas is viewport-sized and
//   fixed, with digits positioned in page coordinates, so long pages don't need a huge canvas.
//   z-index -1 puts it behind all content (at 0 it painted over anything unpositioned, cards
//   included), and digits that would overlap text are skipped, so text stays clean at any density.
---

<canvas class="bb-digital-rain" aria-hidden="true"></canvas>

<style>
  .bb-digital-rain {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    /* Large viewport height, so mobile browser chrome collapsing doesn't resize and clear it. */
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bb-digital-rain {
      display: none !important;
    }
  }
</style>

<script>
  function initDigitalRain() {
    const canvas = document.querySelector<HTMLCanvasElement>('.bb-digital-rain');
    if (!canvas) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Same light/dark detection as the logo's CSS-mask swap (BUGFIX-007) -- one source of
    // truth for "is this page currently in light theme", not a second detection mechanism.
    function isLightTheme() {
      const theme = document.documentElement.dataset.theme;
      if (theme === 'dark') return false;
      if (theme === 'light') return true;
      return window.matchMedia('(prefers-color-scheme: light)').matches;
    }

    function currentStyle() {
      const styles = getComputedStyle(document.documentElement);
      if (isLightTheme()) {
        return {
          color: styles.getPropertyValue('--color-foreground').trim() || '#111114',
          alpha: 0.36, // POLISH-002: 0.2 and 0.28 both still too faint against #FAFAF9 on a real phone
        };
      }
      return {
        color: styles.getPropertyValue('--color-accent').trim() || '#00E5A0',
        alpha: 0.32, // POLISH-002: 0.22 still didn't separate from #0B0D10 on a real phone
      };
    }

    const fontSize = 14;
    const rowHeight = fontSize * 1.6;
    const chars = '01';
    // Same top-of-page density as the old band: one digit per 33px column (POLISH-004) per 500px.
    const topDensity = 1 / (33 * 500);
    const columnGap = 33;
    const minDensity = 0.1; // share of topDensity left at the very bottom of the page
    const textPadding = 4;

    type Drop = { x: number; startY: number; y: number; travel: number; speed: number; char: string };

    let width = 0;
    let height = 0;
    let pageHeight = 0;
    let drops: Drop[] = [];
    let textRects: { top: number; bottom: number; left: number; right: number }[] = [];
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let running = true;
    let lastFrame = 0;
    let lastScrollY = -1;
    const frameInterval = 1000 / 15; // capped ~15fps -- verified fine on mobile, see docs/decisions.md

    function densityAt(y: number) {
      const remaining = 1 - Math.min(y / pageHeight, 1);
      return minDensity + (1 - minDensity) * remaining * remaining;
    }

    // Rejection sampling, so digits land according to densityAt.
    function spawn(): Drop {
      let startY = 0;
      do {
        startY = Math.random() * pageHeight;
      } while (Math.random() > densityAt(startY));
      const columnCount = Math.max(1, Math.floor(width / columnGap));
      return {
        x: Math.floor(Math.random() * columnCount) * columnGap + columnGap / 2,
        startY,
        y: startY,
        travel: 240 + Math.random() * 400,
        speed: 1.4 + Math.random() * 1.4,
        char: '0',
      };
    }

    function measureText() {
      const rects: typeof textRects = [];
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const range = document.createRange();
      while (walker.nextNode()) {
        const node = walker.currentNode;
        if (!node.nodeValue?.trim() || node.parentElement?.closest('script, style')) continue;
        range.selectNodeContents(node);
        for (const r of range.getClientRects()) {
          rects.push({
            top: r.top + window.scrollY - textPadding,
            bottom: r.bottom + window.scrollY + textPadding,
            left: r.left + window.scrollX - textPadding,
            right: r.right + window.scrollX + textPadding,
          });
        }
      }
      textRects = rects;
    }

    function overlapsText(x: number, y: number) {
      // fillText draws from the baseline, so the digit occupies the box above y.
      return textRects.some((r) => x + fontSize > r.left && x < r.right && y > r.top && y - fontSize < r.bottom);
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      const widthChanged = rect.width !== width;
      width = rect.width;
      height = rect.height;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      measurePage(widthChanged);
    }

    function measurePage(respawn = false) {
      const nextHeight = Math.max(document.documentElement.scrollHeight, height);
      const heightChanged = Math.abs(nextHeight - pageHeight) > 1;
      pageHeight = nextHeight;
      measureText();
      if (!respawn && !heightChanged) return;
      // Integral of densityAt over the page is pageHeight * (minDensity + (1 - minDensity) / 3).
      const count = Math.round(topDensity * width * pageHeight * (minDensity + (1 - minDensity) / 3));
      drops = Array.from({ length: count }, () => {
        const drop = spawn();
        drop.y = drop.startY + Math.random() * drop.travel; // already mid-fall on load
        return drop;
      });
    }

    function render() {
      const style = currentStyle();
      const scrollY = window.scrollY;
      lastScrollY = scrollY;

      ctx!.clearRect(0, 0, width, height);
      ctx!.font = `${fontSize}px ui-monospace, "SF Mono", Menlo, Consolas, monospace`;
      ctx!.fillStyle = style.color;

      for (const drop of drops) {
        const screenY = drop.y - scrollY;
        if (screenY < -rowHeight || screenY > height + rowHeight || overlapsText(drop.x, drop.y)) continue;
        const progress = (drop.y - drop.startY) / drop.travel;
        ctx!.globalAlpha = style.alpha * Math.min(1, progress * 5, (1 - progress) * 5); // fade at both ends
        ctx!.fillText(drop.char, drop.x, screenY);
      }
    }

    function draw(time: number) {
      if (!running) return;
      requestAnimationFrame(draw);

      if (time - lastFrame < frameInterval) {
        // Digits belong to the page, so they have to keep up with scrolling between frames.
        if (window.scrollY !== lastScrollY) render();
        return;
      }
      lastFrame = time;

      for (let i = 0; i < drops.length; i++) {
        const drop = drops[i];
        drop.y += drop.speed;
        drop.char = chars[Math.floor(Math.random() * chars.length)];
        if (drop.y - drop.startY > drop.travel) drops[i] = spawn();
      }
      render();
    }

    resize();
    requestAnimationFrame(draw);

    const ro = new ResizeObserver(() => resize());
    ro.observe(canvas);

    // Page content changing height (fonts loading, an FAQ opening) moves text without resizing the canvas.
    const pageObserver = new ResizeObserver(() => measurePage());
    pageObserver.observe(document.body);
    document.fonts?.ready.then(() => measureText());
    // Scroll reveals shift text while they play, so its measured position is only right afterwards.
    document.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform' && (e.target as Element).matches('[data-reveal]')) measureText();
    });

    // Stop entirely if reduced-motion is toggled live.
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) {
        running = false;
        ctx!.clearRect(0, 0, width, height);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDigitalRain);
  } else {
    initDigitalRain();
  }
</script>

---
// A restrained nod to falling 0s/1s -- the idea of it, not a literal Matrix screensaver.
// Sparse slow columns, canvas capped ~15fps. Mounted once at the layout level (BaseLayout)
// so it appears at the top of every page, confined to a fixed-height band on desktop / full
// viewport height on mobile -- not stretching down the full scroll length of longer pages.
// Disabled under prefers-reduced-motion (always) -- mobile is enabled as of BUGFIX-010.
//
// Tuning history (density/speed unchanged throughout -- only visibility/placement moved):
// BUGFIX-004/006: opacity 6%->12%->22% (dark theme, accent mint) -- imperceptible at lower
//   values on a real screen despite drawing correctly.
// BUGFIX-009: moved from homepage-hero-only to a shared layout-level top band on every page,
//   added theme-aware color (dark: accent mint 22%, light: muted-text 16%).
// POLISH-001: light-theme color/opacity darkened further -- muted-text wasn't dark enough
//   even at 16%. Switched to --color-foreground (the actual body-text color) at 20%.
// BUGFIX-010(1): mobile was deliberately disabled at launch (battery/perf reasoning) --
//   owner has now seen the live site on a real phone and wants it there too. Re-enabled;
//   see docs/decisions.md for the mobile performance check performed before shipping this.
// POLISH-002 (mobile-height): mobile now sizes to the full visible viewport height on load
//   (100dvh) instead of the fixed desktop band, per explicit follow-up request -- verified via
//   Lighthouse, see docs/decisions.md for before/after numbers.
// POLISH-002 (contrast, later follow-up reusing the same task ID): opacity-only tuning had
//   diminishing returns -- even at 22%/20% the digits still barely separated in luminance from
//   the near-black/near-white background on a real phone. Raised dark to 32%; light needed two
//   passes (28% was still too faint against #FAFAF9 on an actual screenshot) before landing at
//   36%. Colors (accent mint / --color-foreground) were already correct from BUGFIX-006/POLISH-001,
//   this was purely an opacity increase. See docs/decisions.md for the before/after screenshots.
---

<canvas class="bb-digital-rain" aria-hidden="true"></canvas>

<style>
  .bb-digital-rain {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    /* Mobile: fills the screen the visitor lands on (100dvh accounts for mobile browser
       chrome better than 100vh), then scrolls away normally -- not pinned, not stretching
       down the rest of the page. */
    height: 100vh;
    height: 100dvh;
    z-index: 0;
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .bb-digital-rain {
      height: 31.25rem; /* ~500px desktop band -- roughly a typical hero height, not the full page */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bb-digital-rain {
      display: none !important;
    }
  }
</style>

<script>
  function initDigitalRain() {
    const canvas = document.querySelector<HTMLCanvasElement>('.bb-digital-rain');
    if (!canvas) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Same light/dark detection as the logo's CSS-mask swap (BUGFIX-007) -- one source of
    // truth for "is this page currently in light theme", not a second detection mechanism.
    function isLightTheme() {
      const theme = document.documentElement.dataset.theme;
      if (theme === 'dark') return false;
      if (theme === 'light') return true;
      return window.matchMedia('(prefers-color-scheme: light)').matches;
    }

    function currentStyle() {
      const styles = getComputedStyle(document.documentElement);
      if (isLightTheme()) {
        return {
          color: styles.getPropertyValue('--color-foreground').trim() || '#111114',
          alpha: 0.36, // POLISH-002: 0.2 and 0.28 both still too faint against #FAFAF9 on a real phone
        };
      }
      return {
        color: styles.getPropertyValue('--color-accent').trim() || '#00E5A0',
        alpha: 0.32, // POLISH-002: 0.22 still didn't separate from #0B0D10 on a real phone
      };
    }

    const fontSize = 14;
    // POLISH-004: 42 -> 33 gives roughly +25-30% more columns at every viewport width
    // tested (1440px: 34->43, 768px: 18->23, 390px: 9->11) -- density-only change, opacity/
    // speed/font-size/frame-cap/band-height all untouched. Narrower mobile viewports still
    // naturally get proportionally fewer columns than desktop, no separate mobile density needed.
    const columnGap = 33;
    const rowHeight = fontSize * 1.6;
    const chars = '01';

    let width = 0;
    let height = 0;
    let columns: { x: number; y: number; speed: number; nextStep: number }[] = [];
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let running = true;
    let lastFrame = 0;
    const frameInterval = 1000 / 15; // capped ~15fps -- verified fine on mobile, see docs/decisions.md

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas!.width = width * dpr;
      canvas!.height = height * dpr;
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const columnCount = Math.max(1, Math.floor(width / columnGap));
      columns = Array.from({ length: columnCount }, (_, i) => ({
        x: i * columnGap + columnGap / 2,
        // start already scattered through the visible area (not just above it) so the
        // effect is present immediately on load instead of taking ~10s to trickle in
        y: Math.random() * height * 1.4 - height * 0.4,
        speed: 1.4 + Math.random() * 1.4, // slow fall: ~15-30s to cross the band height
        nextStep: 0,
      }));
    }

    function draw(time: number) {
      if (!running) return;
      requestAnimationFrame(draw);

      if (time - lastFrame < frameInterval) return;
      lastFrame = time;

      const style = currentStyle();

      ctx!.clearRect(0, 0, width, height);
      ctx!.font = `${fontSize}px ui-monospace, "SF Mono", Menlo, Consolas, monospace`;
      ctx!.fillStyle = style.color;
      ctx!.globalAlpha = style.alpha;

      for (const col of columns) {
        const char = chars[Math.floor(Math.random() * chars.length)];
        ctx!.fillText(char, col.x, col.y);
        col.y += col.speed;
        if (col.y > height + rowHeight) {
          col.y = -rowHeight - Math.random() * height * 0.5; // organic, staggered restart
        }
      }
    }

    resize();
    requestAnimationFrame(draw);

    const ro = new ResizeObserver(() => resize());
    ro.observe(canvas);

    // Stop entirely if reduced-motion is toggled live.
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) {
        running = false;
        ctx!.clearRect(0, 0, width, height);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDigitalRain);
  } else {
    initDigitalRain();
  }
</script>
